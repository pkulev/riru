import os

# CFGDIR is the directory containing this file, set by tools/config.py.
_root = os.environ["CFGDIR"]
LLVM_ROOT = os.path.normpath(os.path.join(_root, "..", "bin"))
BINARYEN_ROOT = os.path.normpath(os.path.join(_root, ".."))
NODE_JS = "@NODE@"

# The shipped cache is owned by this package. Do not seed ~/.cache and do not
# symlink it at the system cache: emcc writes through those links, and a
# sandboxed build of another package then dies with an access violation on
# /usr/lib*/emscripten. Keep the shipped cache frozen instead.
# A writable cache is opt-in: EM_CACHE=/some/dir EM_FROZEN_CACHE=0
if not os.environ.get("EM_CACHE"):
    CACHE = os.path.join(_root, "cache")
    FROZEN_CACHE = True
